# 复制本文件为 .env 并填入你实际使用的密钥（未启用的项可留空或删除）

# REST API 访问鉴权 Token（建议生成随机长字符串）
GER_API_TOKEN=change-me-strong-token

# 通知通道（ntfy / Bark 至少配置一个）
NTFY_TOPIC=my-game-events-secret
NTFY_TOKEN=
BARK_DEVICE_KEY=

# 通用 OpenAI 兼容接口（可接 OpenAI / DeepSeek / 硅基流动 / 中转站）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 联网搜索 API（搭配 OpenAI 兼容接口使用）
TAVILY_API_KEY=
EXA_API_KEY=

# Google Gemini API（支持原生 Google Search 联网搜索）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 可选：GitHub Token（提高拉取 gameg.site YAML 时的 GitHub API 速率限制）
GITHUB_TOKEN=
